{
  "_comment": "place_order (SQL) vs LocalStore/priceOrder. phone '@rich' = a seeded customer with >= 300 points; missing phone = a fresh number per case. 'expect' is 'ok' or the error code both stores must return. 'setup' patches settings for that case only.",
  "coupons": [
    { "code": "PCT50", "type": "percent", "value": 50, "minOrder": 0, "maxDiscount": 120, "expiresAt": null, "usageLimit": null, "usedCount": 0, "firstOrderOnly": false, "active": true },
    { "code": "PCT15", "type": "percent", "value": 15, "minOrder": 0, "maxDiscount": null, "expiresAt": "2099-12-31T00:00:00.000Z", "usageLimit": null, "usedCount": 0, "firstOrderOnly": false, "active": true },
    { "code": "FLAT999", "type": "flat", "value": 999, "minOrder": 0, "maxDiscount": null, "expiresAt": null, "usageLimit": null, "usedCount": 0, "firstOrderOnly": false, "active": true },
    { "code": "OLD20", "type": "percent", "value": 20, "minOrder": 0, "maxDiscount": null, "expiresAt": "2000-01-01T00:00:00.000Z", "usageLimit": null, "usedCount": 0, "firstOrderOnly": false, "active": true },
    { "code": "OFF10", "type": "flat", "value": 10, "minOrder": 0, "maxDiscount": null, "expiresAt": null, "usageLimit": null, "usedCount": 0, "firstOrderOnly": false, "active": false },
    { "code": "ONCE", "type": "flat", "value": 10, "minOrder": 0, "maxDiscount": null, "expiresAt": null, "usageLimit": 1, "usedCount": 1, "firstOrderOnly": false, "active": true }
  ],
  "cases": [
    { "name": "plain single item", "expect": "ok", "input": { "lines": [{ "itemId": "the-beginning-chicken-cutlets", "optionIds": [], "qty": 1 }] } },
    { "name": "odd tax split (130 -> tax 7 = 3 + 4)", "expect": "ok", "input": { "lines": [{ "itemId": "the-beginning-chicken-cutlets", "optionIds": [], "qty": 1 }] } },
    { "name": "tax half-rupee rounding (150 -> 7.5)", "expect": "ok", "input": { "lines": [{ "itemId": "healthy-scrambles-tuscan-scramble", "optionIds": [], "qty": 1 }] } },
    { "name": "priced choice option x3", "expect": "ok", "input": { "lines": [{ "itemId": "healthy-breakfast-oats-porridge-quinoa-porridge", "optionIds": ["healthy-breakfast-oats-porridge-quinoa-porridge--choice-quinoa-porridge"], "qty": 3, "note": "less sugar" }] } },
    { "name": "two add-ons + second line", "expect": "ok", "input": { "lines": [
      { "itemId": "healthy-breakfast-sprouts-with-honey-spicy-sprouts", "optionIds": ["healthy-breakfast-sprouts-with-honey-spicy-sprouts--add-ons-fresh-fruits-dry-fruits", "healthy-breakfast-sprouts-with-honey-spicy-sprouts--add-ons-honey-maple-syrup"], "qty": 2 },
      { "itemId": "breads-french-toast", "optionIds": [], "qty": 1 }
    ] } },
    { "name": "free dressing", "expect": "ok", "input": { "lines": [{ "itemId": "healthy-salads-fruit-salad", "optionIds": ["healthy-salads-fruit-salad--dressing-yogurt"], "qty": 1 }] } },
    { "name": "percent coupon capped by maxDiscount", "expect": "ok", "input": { "couponCode": "pct50", "lines": [{ "itemId": "breads-healthy-breakfast-combo", "optionIds": [], "qty": 4 }] } },
    { "name": "percent coupon half-rupee rounding (15% of 190 = 28.5)", "expect": "ok", "input": { "couponCode": "PCT15", "lines": [{ "itemId": "breads-bread-toast", "optionIds": [], "qty": 1 }, { "itemId": "egg-specials-double-protein-egg-fillet", "optionIds": [], "qty": 1 }, { "itemId": "egg-specials-boiled-eggs", "optionIds": [], "qty": 1 }] } },
    { "name": "flat coupon larger than subtotal clamps to zero total", "expect": "ok", "input": { "couponCode": "FLAT999", "lines": [{ "itemId": "egg-specials-boiled-eggs", "optionIds": [], "qty": 1 }] } },
    { "name": "welcome coupon on a first order", "expect": "ok", "input": { "couponCode": " Welcome10 ", "lines": [{ "itemId": "breads-healthy-breakfast-combo", "optionIds": [], "qty": 2 }] } },
    { "name": "loyalty capped at 50% of (subtotal - coupon)", "expect": "ok", "input": { "phone": "@rich", "pointsToRedeem": 300, "lines": [{ "itemId": "the-beginning-chicken-cutlets", "optionIds": [], "qty": 1 }] } },
    { "name": "coupon + loyalty stacked", "expect": "ok", "input": { "phone": "@rich", "pointsToRedeem": 100, "couponCode": "TIRAMISU50", "lines": [{ "itemId": "breads-healthy-breakfast-combo", "optionIds": [], "qty": 3 }] } },
    { "name": "takeaway online", "expect": "ok", "input": { "mode": "takeaway", "table": null, "pickupTime": "13:15", "lines": [{ "itemId": "breads-exotic-french-toast", "optionIds": [], "qty": 2 }] } },
    { "name": "dine-in cash", "expect": "ok", "input": { "plan": { "kind": "cash" } } },
    { "name": "dine-in split", "expect": "ok", "input": { "plan": { "kind": "split", "onlineAmount": 120 } } },

    { "name": "not accepting orders", "expect": "NOT_ACCEPTING", "setup": { "acceptingOrders": false }, "input": {} },
    { "name": "bad phone", "expect": "BAD_PHONE", "input": { "phone": "12345" } },
    { "name": "bad phone first digit", "expect": "BAD_PHONE", "input": { "phone": "5876543210" } },
    { "name": "phone checked before name and table", "expect": "BAD_PHONE", "input": { "phone": "1", "name": "", "table": 99 } },
    { "name": "blank name", "expect": "BAD_NAME", "input": { "name": "   " } },
    { "name": "61-char name", "expect": "BAD_NAME", "input": { "name": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" } },
    { "name": "name checked before table", "expect": "BAD_NAME", "input": { "name": "", "table": 0 } },
    { "name": "missing table", "expect": "BAD_TABLE", "input": { "table": null } },
    { "name": "table out of range", "expect": "BAD_TABLE", "input": { "table": 11 } },
    { "name": "fractional table", "expect": "BAD_TABLE", "input": { "table": 2.5 } },
    { "name": "takeaway without pickup", "expect": "BAD_PICKUP", "input": { "mode": "takeaway", "table": null, "pickupTime": null } },
    { "name": "takeaway cash", "expect": "CASH_DINE_IN_ONLY", "input": { "mode": "takeaway", "table": null, "pickupTime": "13:00", "plan": { "kind": "cash" } } },
    { "name": "takeaway split", "expect": "CASH_DINE_IN_ONLY", "input": { "mode": "takeaway", "table": null, "pickupTime": "13:00", "plan": { "kind": "split", "onlineAmount": 50 } } },
    { "name": "points not a multiple of 100", "expect": "BAD_POINTS", "input": { "pointsToRedeem": 50 } },
    { "name": "negative points", "expect": "BAD_POINTS", "input": { "pointsToRedeem": -100 } },
    { "name": "NaN points (null in JSON)", "expect": "BAD_POINTS", "input": { "pointsToRedeem": null } },
    { "name": "points above balance", "expect": "BAD_POINTS", "input": { "pointsToRedeem": 100 } },
    { "name": "points checked before cart", "expect": "BAD_POINTS", "input": { "pointsToRedeem": 7, "lines": [] } },
    { "name": "empty cart before coupon lookup", "expect": "EMPTY_CART", "input": { "couponCode": "NOPE", "lines": [] } },
    { "name": "unknown coupon", "expect": "COUPON_NOT_FOUND", "input": { "couponCode": "NOPE" } },
    { "name": "expired seed coupon", "expect": "COUPON_EXPIRED", "input": { "couponCode": "GG100", "lines": [{ "itemId": "breads-healthy-breakfast-combo", "optionIds": [], "qty": 3 }] } },
    { "name": "expired custom coupon", "expect": "COUPON_EXPIRED", "input": { "couponCode": "OLD20" } },
    { "name": "inactive coupon", "expect": "COUPON_INACTIVE", "input": { "couponCode": "OFF10" } },
    { "name": "coupon usage limit", "expect": "COUPON_LIMIT", "input": { "couponCode": "ONCE" } },
    { "name": "coupon min order", "expect": "COUPON_MIN_ORDER", "input": { "couponCode": "TIRAMISU50", "lines": [{ "itemId": "the-beginning-chicken-cutlets", "optionIds": [], "qty": 1 }] } },
    { "name": "first-order-only coupon for a returning customer", "expect": "COUPON_FIRST_ORDER_ONLY", "input": { "phone": "@rich", "couponCode": "WELCOME10" } },
    { "name": "empty cart", "expect": "EMPTY_CART", "input": { "lines": [] } },
    { "name": "unknown item", "expect": "ITEM_UNAVAILABLE", "input": { "lines": [{ "itemId": "ghost", "optionIds": [], "qty": 1 }] } },
    { "name": "qty zero", "expect": "BAD_QTY", "input": { "lines": [{ "itemId": "breads-bread-toast", "optionIds": [], "qty": 0 }] } },
    { "name": "qty 51", "expect": "BAD_QTY", "input": { "lines": [{ "itemId": "breads-bread-toast", "optionIds": [], "qty": 51 }] } },
    { "name": "fractional qty", "expect": "BAD_QTY", "input": { "lines": [{ "itemId": "breads-bread-toast", "optionIds": [], "qty": 1.5 }] } },
    { "name": "qty checked before item", "expect": "BAD_QTY", "input": { "lines": [{ "itemId": "ghost", "optionIds": [], "qty": 0 }] } },
    { "name": "unknown option", "expect": "BAD_OPTION", "input": { "lines": [{ "itemId": "breads-bread-toast", "optionIds": ["nope"], "qty": 1 }] } },
    { "name": "option from another item", "expect": "BAD_OPTION", "input": { "lines": [{ "itemId": "breads-bread-toast", "optionIds": ["healthy-salads-fruit-salad--dressing-yogurt"], "qty": 1 }] } },
    { "name": "duplicate add-on", "expect": "BAD_OPTION", "input": { "lines": [{ "itemId": "healthy-breakfast-sprouts-with-honey-spicy-sprouts", "optionIds": ["healthy-breakfast-sprouts-with-honey-spicy-sprouts--add-ons-honey-maple-syrup", "healthy-breakfast-sprouts-with-honey-spicy-sprouts--add-ons-honey-maple-syrup"], "qty": 1 }] } },
    { "name": "two dressings (single-choice group)", "expect": "BAD_OPTION", "input": { "lines": [{ "itemId": "healthy-salads-fruit-salad", "optionIds": ["healthy-salads-fruit-salad--dressing-yogurt", "healthy-salads-fruit-salad--dressing-mayo"], "qty": 1 }] } },
    { "name": "split online zero", "expect": "BAD_SPLIT", "input": { "plan": { "kind": "split", "onlineAmount": 0 } } },
    { "name": "split online above total", "expect": "BAD_SPLIT", "input": { "plan": { "kind": "split", "onlineAmount": 100000 } } },
    { "name": "split online equal to total", "expect": "BAD_SPLIT", "input": { "lines": [{ "itemId": "egg-specials-boiled-eggs", "optionIds": [], "qty": 1 }], "plan": { "kind": "split", "onlineAmount": 32 } } }
  ]
}
